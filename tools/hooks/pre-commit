#!/bin/sh
# Run the documentation linter before every commit.
# Install once:  git config core.hooksPath tools/hooks

set -e

if ! command -v python >/dev/null 2>&1; then
    echo "pre-commit: python not found, skipping the documentation lint" >&2
    exit 0
fi

python tools/make_index.py --check || {
    echo >&2
    echo "pre-commit: a register index is out of date. Run tools/make_index.py — it" >&2
    echo "regenerates the index from the entries and is safe to run at any time." >&2
    exit 1
}

python tools/lint_workbook.py || {
    echo >&2
    echo "pre-commit: documentation lint failed. Fix the errors above, or commit with" >&2
    echo "--no-verify if you are deliberately committing a broken intermediate state." >&2
    exit 1
}

# The workbook-triggers mod carries a copy of the RULES.md section 2 table for where it
# runs installed, without RULES.md beside it. Where that file exists (the standard's own
# repository), the copy has to match.
if [ -f tools/mods/workbook-triggers/hooks/register.ts ]; then
    python tools/check_triggers.py --verify-fallback tools/mods/workbook-triggers/hooks/register.ts || exit 1
fi

# Not a gate: when code is staged and the workbook is not, print the update triggers of
# RULES.md section 2, the moment their entry can still go into this same commit.
python tools/check_triggers.py || true
